{
  "name": "amtrak-e2e-tests",
  "version": "1.0.0",
  "description": "E2E test framework for the Amtrak homepage, deliberately scoped to the \"Find trains\" search form and its inputs. Written in Playwright for Node.js and TypeScript.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check"
  },
  "author": "Cole Dapprich",
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "test-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdsoftw/amtrak-e2e-tests.git"
  },
  "bugs": {
    "url": "https://github.com/cdsoftw/amtrak-e2e-tests/issues"
  },
  "homepage": "https://github.com/cdsoftw/amtrak-e2e-tests#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
